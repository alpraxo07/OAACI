# ─── Required ───────────────────────────────────────────────────────────
# PostgreSQL connection. With Neon/Supabase use the *pooled* URL here and the
# *direct* (non-pooled) URL in DIRECT_URL. Locally both can be the same.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oaaci"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oaaci"

# Public URL of the site, without a trailing slash (used in emails and OAuth).
APP_URL="http://localhost:3000"

# Long random string. Generate one with:  openssl rand -base64 32
SESSION_SECRET=""

# Comma-separated emails that become admins automatically when they sign up.
ADMIN_EMAILS=""

# ─── Media uploads: Cloudinary (free plan) ─────────────────────────────
# Required in production. Without it, uploads are saved to public/uploads
# in development only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email (verification, password reset, invites) ─────────────────────
# Any SMTP provider works (Brevo, Resend, Gmail app password, Zoho…).
# Without it, emails are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="OAACI <no-reply@example.com>"

# ─── Google login (optional) ────────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Phone OTP login (optional, SMS is a paid service) ──────────────────
# Twilio credentials. Without them, phone login is hidden in production and
# OTP codes are printed to the server console in development.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Either a sender number (+1...) or a Messaging Service SID (MG...)
TWILIO_FROM=""

# ─── Real-time chat & notifications: Pusher Channels (free sandbox) ────
# Without it, the app falls back to polling every few seconds.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# ─── Automatic image moderation: Sightengine (optional, free tier) ─────
# Explicit images are held for review; suggestive ones are blurred.
SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""
